{
  "id": "auto-spawn",
  "name": "Auto Spawn",
  "version": "1.0.0",
  "description": "Automatically spawns every connected instance and logs chat.",
  "command": "node",
  "args": ["main.mjs"],
  "events": [
    "instance.created",
    "client.appearance",
    "client.chat"
  ],
  "enabled": true,
  "restart": true
}
